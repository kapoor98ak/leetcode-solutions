# Maximum Sum of Subarrays With Length K

def answer(k: int, arr: list) -> int:
    res = 0
    left, right, n = 0, 0, len(arr)
    window_sum = 0

    while right < n:
        window_sum += arr[right]
        print(f"\twindow_sum: {window_sum} - res: {res}")
        res = window_sum if window_sum > res else res
        window_size = right - left + 1
        if(window_size >= k):
            # windwow breach
            print(f"Window from index: {left} -to- {right} and sum: {window_sum} - res: {res}")
            window_sum -= arr[left]
            left += 1
        right+=1

    return res


print(answer(3, [2, 1, 5, 1, 3, 2]))